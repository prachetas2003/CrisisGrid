# CrisisGrid environment template. Copy to .env and fill in values.
# NEVER commit a real .env file.

# --- LLM (needed from Milestone 2 onward; agents run server-side only) ---
GOOGLE_API_KEY=

# --- Runtime mode ---
# true  = fully offline deterministic demo (scenario data only)
# false = live adapters (weather + configured import feeds) with scenario fallback
DEMO_MODE=true

# --- Live provider scheduler ---
# Starts background refresh jobs for weather and any configured import feed URLs.
PROVIDER_SCHEDULER_ENABLED=true
WEATHER_REFRESH_INTERVAL_MS=300000
LIVE_IMPORT_FEED_INTERVAL_MS=60000

# Comma-separated endpoints that return a LiveImportRequest JSON object, an
# array of LiveImportRequest objects, or { "imports": [...] }.
# These feeds can drive gridOutages, traffic, closures, shelters, and
# facilityPower without using the manual demo import path.
LIVE_IMPORT_FEED_URLS=
LIVE_IMPORT_FEED_TOKEN=
LIVE_IMPORT_FEED_HEADERS_JSON=

# --- Paths & ports ---
# SQLite database file. Relative paths resolve against the repo root, so every
# service (server, MCP, CLI) shares one database regardless of launch cwd.
DATABASE_PATH=./data/crisisgrid.sqlite
SERVER_PORT=18080
AGENTS_PORT=8090
MCP_PORT=8100
WEB_PORT=5173

# --- Security ---
# Secret used to mint single-use approval tokens (HMAC). Generate a long random string.
SERVER_SECRET=

# Optional API keys for mutating routes. When unset, local development remains
# open. When set, use Authorization: Bearer <token> or x-api-key.
# Formats:
#   viewer=read-token,operator=ops-token,admin=admin-token
#   ops:operator:ops-token,lead:admin:admin-token
CRISISGRID_API_KEYS=
