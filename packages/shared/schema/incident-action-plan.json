{
  "$ref": "#/definitions/incident-action-plan",
  "definitions": {
    "incident-action-plan": {
      "type": "object",
      "properties": {
        "incidentId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "situationSummary": {
          "type": "string"
        },
        "riskScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "safe",
                  "needs_approval",
                  "blocked"
                ]
              },
              "timeWindow": {
                "type": "string",
                "enum": [
                  "immediate",
                  "short_term",
                  "next_period"
                ]
              },
              "targetTeam": {
                "type": "string"
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sourceFindings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "simulated": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "id",
              "title",
              "description",
              "tier",
              "timeWindow",
              "targetTeam",
              "dependsOn",
              "sourceFindings"
            ],
            "additionalProperties": false
          }
        },
        "timePhases": {
          "type": "object",
          "properties": {
            "immediate": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "shortTerm": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nextPeriod": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "immediate",
            "shortTerm",
            "nextPeriod"
          ],
          "additionalProperties": false
        },
        "conflictResolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "conflictId": {
                "type": "string"
              },
              "decision": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "conflictId",
              "decision",
              "rationale",
              "evidenceRefs"
            ],
            "additionalProperties": false
          }
        },
        "commsPlan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolvedRisks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "incidentId",
        "revision",
        "situationSummary",
        "riskScore",
        "objectives",
        "actions",
        "timePhases",
        "conflictResolutions",
        "commsPlan",
        "unresolvedRisks",
        "assumptions",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
